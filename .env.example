# Local (SQLite). Para produção no Supabase, troque o provider no schema para postgresql
# e use a connection string do Project Settings > Database.
DATABASE_URL="file:./dev.db"

# Supabase Storage (Project Settings > API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[service_role — nunca exponha no frontend]"

# Servidor
PORT=3001
PUBLIC_API_URL="http://localhost:3001"
CLIENT_ORIGIN="http://localhost:5173"

# Frontend (copie também para frontend/.env)
VITE_API_URL="http://localhost:3001"

# Mensalidade (PIX que o cliente te paga). Sem isso, o aviso usa o PIX da loja.
MENSALIDADE_PIX_CHAVE="+55SEUNUMERO"
MENSALIDADE_PIX_NOME="Luiz Gustavo"

# Chave só sua para liberar o mês. Se estiver vazia, o ADMIN da loja consegue renovar (só use assim no seu PDV).
LICENCA_MASTER_KEY=""
