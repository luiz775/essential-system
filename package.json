{
  "name": "essence-pdv",
  "private": true,
  "version": "1.0.0",
  "description": "PDV de perfumes — React, Node, Prisma e Supabase Storage",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w essence-pdv-backend\" \"npm run dev -w essence-pdv-frontend\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
